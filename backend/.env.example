# ===== AI 智能营养师 环境变量配置 =====
# 使用：复制本文件为 .env 并填入真实密钥（.env 已被 .gitignore 忽略，不会提交）

# 通义千问 LLM + Embedding（DashScope，阿里云）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 视觉模型（阿里云百炼，qwen3.7-plus）
OPENAI_API_KEY=your_bailian_api_key_here

# LangSmith 调试追踪（可选，用于查看 Agent 调用链）
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=rag_project
