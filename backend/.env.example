# ===== AI 智能营养师 环境变量配置 =====
# 使用：复制本文件为 .env 并填入真实密钥（.env 已被 .gitignore 忽略，不会提交）

# ---------- 主密钥：阿里云百炼 MaaS（OpenAI 兼容协议）----------
# 文本 LLM、视觉模型、Embedding 默认共用这一个 key
OPENAI_API_KEY=your_bailian_api_key_here

# ---------- 文本 LLM（对话回复）----------
# 可选：覆盖默认模型/地址/最大输出
# LLM_MODEL=qwen3.7-plus
# LLM_BASE_URL=https://ws-dhhwq9r77kravo0p.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# LLM_MAX_TOKENS=10000

# ---------- 视觉模型（食物图片分析）----------
# 可选覆盖（默认复用 OPENAI_API_KEY）
# VISION_MODEL=qwen3.7-plus
# VISION_BASE_URL=https://ws-dhhwq9r77kravo0p.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# ---------- Embedding（向量化）----------
# 可选覆盖（默认复用 OPENAI_API_KEY）
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_BASE_URL=https://ws-dhhwq9r77kravo0p.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# ---------- 向量库 ----------
# CHROMA_PERSIST_DIR=./chroma_db
# CHROMA_COLLECTION=nutrition_kb
# RETRIEVE_TOP_K=3

# ---------- 数据库（PostgreSQL：用户 / 会话 / 历史消息）----------
# 使用：先创建数据库 rag_nutrition（见 README），再替换下面的密码
DATABASE_URL=postgresql+psycopg://postgres:your_pg_password@localhost:5432/rag_nutrition

# ---------- 登录鉴权 ----------
# JWT 签名密钥（生产环境务必改成随机长字符串）
JWT_SECRET=change-me-to-a-long-random-string
# 启动时自动创建的默认管理员（首次启动后请登录并修改密码）
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin

# ---------- LangSmith 调试追踪（可选）----------
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=rag_project
